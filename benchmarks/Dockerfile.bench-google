# Build and run Google protobuf-v4 benchmarks.
#
# The protobuf v4 Rust crate wraps the upb C library and requires:
#   - protoc matching the crate version (36.2 for protobuf = 4.36.2-release)
#   - cmake + g++ for the upb native build
#
# Usage:
#   docker build -t buffa-bench-google -f benchmarks/Dockerfile.bench-google .
#   docker run --rm buffa-bench-google

FROM rust:1.100.0-slim AS builder

# Install build tools: cmake and g++ for upb, curl/unzip for protoc download.
RUN apt-get update && apt-get install -y \
    cmake g++ pkg-config curl unzip \
    && rm -rf /var/lib/apt/lists/*

# Install protoc 36.2 (must match protobuf crate version 4.36.2-release).
ARG TARGETARCH
RUN case "$TARGETARCH" in \
      arm64) ARCH=aarch_64; SHA256=8b8f18bd2b30346efbc698dd5a73dd7c805f3ef8380f6dfc95c768f3f1852f6a;; \
      amd64) ARCH=x86_64; SHA256=121f6c7afe1d4d0e3ea6aab9432038599250134cbf4474cb1167d2c7decd4278;; \
      *) echo "unsupported architecture" >&2; exit 1;; \
    esac \
    && curl -fsSL "https://github.com/protocolbuffers/protobuf/releases/download/v36.2/protoc-36.2-linux-${ARCH}.zip" \
       -o /tmp/protoc.zip \
    && echo "${SHA256}  /tmp/protoc.zip" | sha256sum -c - \
    && unzip -o /tmp/protoc.zip -d /usr/local bin/protoc \
    && rm /tmp/protoc.zip \
    && protoc --version

WORKDIR /workspace

# Copy benchmark shared files and the google benchmark crate.
COPY benchmarks/proto/      benchmarks/proto/
COPY benchmarks/datasets/   benchmarks/datasets/
COPY benchmarks/google/     benchmarks/google/

# protobuf-v4 wraps upb (C); the cc crate does not auto-define NDEBUG, and the
# upstream build.rs doesn't either, so without this every UPB_ASSERT is a live
# assert() and every UPB_ASSUME is assert() instead of __builtin_unreachable().
ENV CFLAGS="-DNDEBUG"

RUN cargo install cargo-criterion \
    && cargo bench --manifest-path benchmarks/google/Cargo.toml --no-run

ENTRYPOINT ["cargo", "criterion", "--manifest-path", "benchmarks/google/Cargo.toml", "--bench", "protobuf", "--message-format=json", "--", "--warm-up-time", "3", "--measurement-time", "5"]
